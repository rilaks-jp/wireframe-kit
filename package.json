{
  "name": "@rilaks/wireframe-kit",
  "version": "0.1.0",
  "description": "Wireframe components for building website wireframes with Vite + React + TypeScript",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "main": "./dist/wireframe-kit.cjs",
  "module": "./dist/wireframe-kit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/wireframe-kit.js",
      "require": "./dist/wireframe-kit.cjs"
    },
    "./styles.css": "./dist/wireframe-kit.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "screenshot": "playwright test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.3.0"
  }
}
